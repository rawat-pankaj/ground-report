# Postgres, pooled connection (Supabase, port 6543, ends with ?pgbouncer=true).
# Used by the app at runtime. User is postgres.<project-ref>.
POSTGRES_PRISMA_URL="postgresql://postgres.your-project-ref:password@host:6543/postgres?pgbouncer=true"

# Postgres, direct connection (Supabase, port 5432).
# Used by Prisma to create or change tables (see README, step 2).
POSTGRES_URL_NON_POOLING="postgresql://postgres.your-project-ref:password@host:5432/postgres"

# YouTube Data API v3 key — see README for how to get one
YOUTUBE_API_KEY="your-youtube-api-key"

# Shared password for the /admin section
ADMIN_PASSWORD="choose-a-strong-password"
