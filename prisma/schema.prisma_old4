generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Channel {
  id                 String   @id @default(cuid())
  youtubeChannelId   String   @unique
  name               String
  thumbnailUrl       String?
  uploadsPlaylistId  String
  lastBrowsedAt      DateTime @default(now())
  videos             Video[]
}

model Video {
  id             String    @id @default(cuid())
  youtubeVideoId String    @unique
  title          String
  thumbnailUrl   String?
  publishedAt    DateTime?
  language       String?
  beatTags       String?
  status         String    @default("published") // published | hidden
  featured       Boolean   @default(false)
  viewCount      BigInt    @default(0)
  addedAt        DateTime  @default(now())
  channelId      String
  channel        Channel   @relation(fields: [channelId], references: [id])
  categories     VideoCategory[]
}

model Nomination {
  id               String    @id @default(cuid())
  type             String    @default("channel") // "channel" | "video"
  input            String
  reasonText       String?
  submitterContact String?
  status           String    @default("pending") // pending | approved | rejected
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  videos    VideoCategory[]
}

model VideoCategory {
  videoId    String
  categoryId String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
}

model NominationRateLimit {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}